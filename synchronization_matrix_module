import os
import numpy as np

base_path = "filtered_bands_motifs"
output_path = "sync_matrices"

os.makedirs(output_path, exist_ok=True)

subjects = [f"sub-{i:02d}" for i in range(1, 11)]
sessions = [f"ses-{i:02d}" for i in range(1, 4)]

def load_and_gather_subject_motifs(subject: str, sessions: list[str], base_path: str) -> np.ndarray:
    session_arrays = []

    for ses in sessions:
        file_path = os.path.join(
            base_path,
            f"{subject}_{ses}_inner_bands_motifs.npy"
        )

        if not os.path.exists(file_path):
            raise FileNotFoundError(f"Arquivo não encontrado: {file_path}")

        x_session = np.load(file_path)
        session_arrays.append(x_session)

    x_subject = np.concatenate(session_arrays, axis=0)
    return x_subject
                  
for subject in subjects:
    print(f"\nProcessando {subject}...")

    gathered_subject_motifs = load_and_gather_subject_motifs(subject, sessions, base_path)
    print("Motifs do sujeito:", gathered_subject_motifs.shape)

    sync_matrices = motif_sync_all_trials_bands(gathered_subject_motifs, lags=(0, 1, 2, 3))
    print("Matrizes de sincronização:", sync_matrices.shape)

    save_path = os.path.join(output_path, f"{subject}_inner_sync_matrices.npy")
    np.save(save_path, sync_matrices)

    print(f"Salvo em: {save_path}")







    




    

for subject in subjects:
    for session in sessions:

        file_path = os.path.join(
            base_path,
            f"{subject}_{session}_inner_bands.npy"
        )

        if not os.path.exists(file_path):
            print(f"Arquivo não encontrado: {file_path}")
            continue

        print(f"\nProcessando {subject} {session}...")

        X_bands = np.load(file_path) #(época × bandas × canais × tempo)

        X_bands_motifs = motif_sequences_all(X_bands)

        save_path = os.path.join(
            output_path,
            f"{subject}_{session}_inner_bands_motifs.npy"
        )

        np.save(save_path, X_bands_motifs)

        print(f"Salvo em: {save_path}")
        print(f"Shape: {X_bands_motifs.shape}")
